# ==============================================================================
# SRCEM CMS - Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# 2. Fill in the required production credentials.
# 3. NEVER commit the actual '.env' file to version control (Git).
# 4. Set strict file permissions on your production server:
#      chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set DEBUG=False for production! (Defaults to False if not set)
DEBUG=False

# Generate a strong, unique secret key for production.
# Generate via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-cryptographically-secure-random-key

# Comma-separated list of host/domain names that this Django site can serve.
# In production, DO NOT use '*' - specify your exact domains or IP addresses.
# Example: ALLOWED_HOSTS=srcem.ac.in,www.srcem.ac.in,203.0.113.195
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF protection (Required for Django 4+ with HTTPS).
# Example: CSRF_TRUSTED_ORIGINS=https://srcem.ac.in,https://www.srcem.ac.in
CSRF_TRUSTED_ORIGINS=https://localhost:8000

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Supported engines:
#   - 'postgresql' (Standard PostgreSQL / Cloudflare Hyperdrive)
#   - 'sqlite3' (Local SQLite file)
#   - 'd1_binding' (Cloudflare Worker runtime using D1 binding)
#   - 'd1_api' (Remote Cloudflare D1 HTTP API for running migrations / CLI)
DB_ENGINE=sqlite3

# PostgreSQL Settings (if DB_ENGINE=postgresql)
DB_NAME=srcem_cms
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=600

# Cloudflare D1 Settings (if DB_ENGINE=d1_binding or DB_ENGINE=d1_api)
# For Worker deployment:
CLOUDFLARE_BINDING=DB
# For running remote migrations / CLI commands against D1 via HTTP API:
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=your_d1_database_id
CLOUDFLARE_TOKEN=your_cloudflare_api_token_with_d1_edit_permissions


# ------------------------------------------------------------------------------
# SSL & Production Security Headers
# ------------------------------------------------------------------------------
# Set to True when your domain has HTTPS configured (Nginx / Cloudflare / Let's Encrypt)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
# In dev: django.core.mail.backends.console.EmailBackend
# In prod: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@domain.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=SRCEM CMS <no-reply@domain.com>
